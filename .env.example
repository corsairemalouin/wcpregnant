# Copier ce fichier en .env (jamais commite) puis ajuster les valeurs.
# Les scripts start.ps1 / start.sh lisent ces variables (ou celles du shell).

# --- Inférence agentique : 100 % locale (Strata AI, API compatible OpenAI) ---
AGENT_INFERENCE_BASE_URL=http://localhost:8000/v1
AGENT_MODEL=Qwen-3.8-Flash-Next
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_ITERATIONS=4

# --- Base PostgreSQL locale (service "db" de docker-compose) ---
# Mot de passe de demonstration uniquement : a remplacer dans un vrai environnement,
# de prefere via un Secret Kubernetes ou une variable d'environnement.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wcpregnant
SPRING_DATASOURCE_USERNAME=wcpregnant
SPRING_DATASOURCE_PASSWORD=changeme

# --- Ports ---
API_PORT=8081
FRONT_PORT=4200